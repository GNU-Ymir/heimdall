in server;

use std::algorithm::searching;
use std::fs;
use std::io;
use std::log;
use std::net;
use std::net::tcp;
use std::stream;
use std::time;

use heimdall::http;

use helpers;

fn onHello(_: HttpRequest)-> HttpResponse {
    HttpResponse(200u32, body-> "hello")
}

fn onEcho(rqt: HttpRequest)-> HttpResponse {
    HttpResponse(200u32, body-> rqt.body)
}

fn onParam(rqt: HttpRequest)-> HttpResponse {
    if let Ok(v) = rqt.parameters["name"] {
        HttpResponse(200u32, body-> v)
    } else {
        HttpResponse(400u32)
    }
}

/**
 * Answer `/hello`, `/echo` (POST) and `/param`
 * */
fn defaultRoutes(dmut server: &HttpServer) {
    server:.route(Path("/hello"), &onHello);
    server:.route(Path("/echo"), &onEcho, method-> HttpRequestKind::POST);
    server:.route(Path("/param"), &onParam);
}

/**
 * Start a server whose routes are set by `routes`, on a port of the loopback picked by the kernel
 * */
fn startOnLoopback(routes: fn (dmut &HttpServer)-> void = &defaultRoutes, nbThreads: u32 = 2u32)-> dmut &HttpServer
    throws HttpError
{
    let dmut server = copy HttpServer(SockAddr(copy Ipv4Addr([127u8, 0u8, 0u8, 1u8]), 0u16), nbThreads-> nbThreads);
    routes(alias server);
    server:.start();

    alias server
}

/**
 * @returns: everything the server at `port` answers to `raw`, read until it closes the connection
 * */
fn exchange(port: u16, raw: [c8])-> [c8] {
    let dmut response = copy StringStream();
    {
        let dmut client = TcpStream::connect(SockAddr(copy Ipv4Addr([127u8, 0u8, 0u8, 1u8]), port));
        client:.setRecvTimeout(seconds(5u64));
        client:.sendRaw(raw);

        {
            loop {
                response:.write(client:.receive!{c8} ());
            }
        } catch {
            _ => {}
        }

        client:.dispose();
    } catch {
        _ => {}
    }

    response[]
}

/**
 * @returns: the answer of a fresh server to `raw`, the server being stopped before returning
 * */
fn roundTrip(raw: [c8], routes: fn (dmut &HttpServer)-> void = &defaultRoutes)-> [c8]
    throws HttpError
{
    let dmut server = startOnLoopback(routes-> routes);
    let response = exchange(server.port, raw);

    server:.kill();
    server:.join();

    response
}

__test answersARoute {
    {
        let response = roundTrip("GET /hello HTTP/1.1\r\n\r\n");
        assert(response.startsWith("HTTP/1.1 200 OK\r\n"), "a");
        assert(contains(response, "Content-Length: 5\r\n"), "b");
        assert(contains(response, "Connection: close\r\n"), "c");
        assert(contains(response, "\r\n\r\nhello"), "d");
    } catch {
        err => { println(err); assert(false, "threw"); }
    }
}

__test echoesTheBody {
    {
        let response = roundTrip("POST /echo HTTP/1.1\r\nContent-Type: text/plain\r\nContent-Length: 15\r\n\r\nheimdall's body");
        assert(response.startsWith("HTTP/1.1 200 OK\r\n"), "a");
        assert(contains(response, "\r\n\r\nheimdall's body"), "b");
    } catch {
        err => { println(err); assert(false, "threw"); }
    }
}

__test readsParameters {
    {
        let response = roundTrip("GET /param?flag&name=heimdall HTTP/1.1\r\n\r\n");
        assert(response.startsWith("HTTP/1.1 200 OK\r\n"), "a");
        assert(contains(response, "\r\n\r\nheimdall"), "b");
    } catch {
        err => { println(err); assert(false, "threw"); }
    }
}

__test notFound {
    {
        let response = roundTrip("GET /missing HTTP/1.0\r\n\r\n");
        assert(response.startsWith("HTTP/1.0 404 Not Found\r\n"), "a");
    } catch {
        err => { println(err); assert(false, "threw"); }
    }
}

__test methodNotAllowed {
    {
        let response = roundTrip("DELETE /hello HTTP/1.1\r\n\r\n");
        assert(response.startsWith("HTTP/1.1 405 Method Not Allowed\r\n"), "a");
    } catch {
        err => { println(err); assert(false, "threw"); }
    }
}

__test malformedRequestLine {
    {
        let response = roundTrip("garbage\r\n\r\n");
        assert(response.startsWith("HTTP/1.1 400 Bad Request\r\n"), "a");
    } catch {
        err => { println(err); assert(false, "threw"); }
    }
}

__test unknownMethod {
    {
        let response = roundTrip("BREW /hello HTTP/1.1\r\n\r\n");
        assert(response.startsWith("HTTP/1.1 400 Bad Request\r\n"), "a");
    } catch {
        err => { println(err); assert(false, "threw"); }
    }
}

__test bodyTooLarge { // refused from its Content-Length, before any of the body is read
    {
        let response = roundTrip("POST /echo HTTP/1.1\r\nContent-Length: 200000000\r\n\r\n");
        assert(response.startsWith("HTTP/1.1 413 Request Entity Too Large\r\n"), "a");
    } catch {
        err => { println(err); assert(false, "threw"); }
    }
}

__test closedConnectionIsNoWarning {
    // A client closing its connection before the response is sent (a browser opening one ahead of
    // time and closing it unused) is worth a debug record, not a warning with a stack trace
    let dmut logs = copy StringStream();
    let dmut sink: &LogSink = copy StringSink(alias logs);
    setLevel("heimdall::http::server", Level::DEBUG);
    addSink(alias sink);

    let response = {
        // a single worker answers the connections in the order they came: once the second one is
        // answered, the first was handled
        let dmut server = startOnLoopback(nbThreads-> 1u32);
        {
            let dmut client = TcpStream::connect(SockAddr(copy Ipv4Addr([127u8, 0u8, 0u8, 1u8]), server.port));
            client:.dispose();
        } catch {
            _ => {}
        }

        let r = exchange(server.port, "GET /hello HTTP/1.1\r\n\r\n");
        server:.kill();
        server:.join();
        r
    } catch {
        err => { println(err); "" }
    };

    removeSink(sink);
    setLevel("heimdall::http::server", Level::INFO);

    assert(response.startsWith("HTTP/1.1 200 OK\r\n"), "the next connection should still be answered");
    assert(contains(logs[], "client closed the connection before the response was sent"), "the closed connection should be logged at debug");
    assert(!contains(logs[], "failed to send a response"), "a closed connection is not a warning");
}
